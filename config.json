{
  "server": {
    "port": 9000,
    "host": "0.0.0.0",
    "read_timeout": 300,
    "websocket": {
      "read_timeout": 300,
      "max_message_size": 2097152,
      "read_buffer_size": 1024,
      "write_buffer_size": 1024,
      "enable_compression": true
    }
  },
  "session": {
    "send_queue_size": 500,
    "max_send_errors": 10
  },
  "vad": {
    "provider": "rknn",
    "type": "silero_vad",
    "pool_size": 10,
    "threshold": 0.3,
    "silero_vad":{
      "model_path": "models/vad/silero-vad-v4-rk3588.rknn",
      "min_silence_duration": 0.05,
      "min_speech_duration": 0.25,
      "max_speech_duration": 8.0,
      "window_size": 512,
      "buffer_size_seconds": 10.0,
      "provider": "rknn"
    },
    "ten_vad":{
      "model_path": "models/vad/ten-vad.int8.onnx",
      "threshold": 0.5,
      "min_silence_duration": 0.5,
      "min_speech_duration": 0.25,
      "max_speech_duration": 10,
      "window_size": 256,
      "buffer_size_seconds": 5,
      "provider": "rknn"
    }
  },
  "recognition": {
    "enabled": true,
    "model_path": "models/asr/sherpa-onnx-rk3588-20-seconds-sense-voice-zh-en-ja-ko-yue-2025-09-09/model.rknn",
    "tokens_path": "models/asr/sherpa-onnx-rk3588-20-seconds-sense-voice-zh-en-ja-ko-yue-2025-09-09/tokens.txt",
    "language": "auto",
    "use_inverse_text_normalization": false,
    "num_threads": 16,
    "provider": "rknn",
    "debug": false
  },
  "speaker": {
    "enabled": true,
    "model_path": "models/speaker/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx",
    "num_threads": 8,
    "provider": "cpu",
    "threshold": 0.6,
    "data_dir": "data/speaker",
    "save_audio_on_finish": false,
    "audio_save_dir": "",
    "storage_type": "qdrant",
    "json_storage": {
      "file_path": "data/speaker/speaker_embeddings.json"
    },
    "qdrant": {
      "host": "192.168.208.214",
      "port": 6334,
      "collection_name": "speaker_embeddings"
    }
  },
  "audio": {
    "sample_rate": 16000,
    "feature_dim": 80,
    "normalize_factor": 32768.0,
    "chunk_size": 4096
  },
  "pool": {
    "instance_mode": "single",
    "worker_count": 500,
    "queue_size": 10000
  },
  "rate_limit": {
    "enabled": false,
    "requests_per_second": 1000,
    "burst_size": 2000,
    "max_connections": 2000
  },
  "response": {
    "send_mode": "queue",
    "timeout": 6
  },
  "logging": {
    "level": "debug",
    "format": "text",
    "output": "both",
    "file_path": "logs/app.log",
    "max_size": 100,
    "max_backups": 5,
    "max_age": 30,
    "compress": true
  },
  "stream_recognition": {
    "enabled": false,
    "model": {
      "encoder": "models/stream/encoder.rknn",
      "decoder": "models/stream/decoder.rknn",
      "joiner": "models/stream/joiner.rknn",
      "tokens": "models/stream/tokens.txt"
    },
    "provider": "rknn",
    "num_threads": 1,
    "max_audio_len": 20,
    "decoding_method": "greedy_search",
    "endpoint": {
      "rule_1_min_trailing_silence": 2.4,
      "rule_2_min_trailing_silence": 1.2,
      "rule_3_min_utterance_length": 20
    }
  }
} 
